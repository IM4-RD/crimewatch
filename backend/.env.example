# CrimeWatch API Configuration for SQLite
# For production MySQL, update DATABASE_URL to use mysql+pymysql

# ── Database ──────────────────────────────────────────
# SQLite requires no user/password setup
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crimewatch
DB_USER=crimewatch_app
DB_PASS=

# ── Application ──────────────────────────────────────
APP_ENV=development
DEBUG=true
PORT=8000

# ── Security ──────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here_change_in_production

# ── File Storage ──────────────────────────────────────
MEDIA_DIR=./media
MAX_UPLOAD_MB=50

# ── RSA Keys ──────────────────────────────────────────
PRIVATE_KEY_PATH=./keys/private.pem
PUBLIC_KEY_PATH=./keys/public.pem
